@using System.Security.Claims

@if (User.Identity?.IsAuthenticated == true)
{
    var nume = User.Identity.Name;
    var rol = User.FindFirstValue(ClaimTypes.Role);

    <ul class="navbar-nav">
        <li class="nav-item">
            <span class="nav-link text-dark">
                <strong>@nume</strong> <small class="text-muted">(@rol)</small>
            </span>
        </li>
        <li class="nav-item">
            <form asp-controller="Auth" asp-action="Logout" method="post" class="form-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link nav-link text-dark border-0">Logout</button>
            </form>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">Autentificare</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Register">Înregistrare</a>
        </li>
    </ul>
}
