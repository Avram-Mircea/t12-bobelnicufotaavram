@*
    Lista de cerințe pentru parolă, cu feedback vizual.
    Model = ID-ul HTML al div-ului (folosit ca target pentru JS).
*@
@model string

<div id="@Model" class="form-text mt-1" style="line-height: 1.6;">
    <span class="req text-muted" data-req="length">⭕ Minim 8 caractere</span><br />
    <span class="req text-muted" data-req="symbol">⭕ Cel puțin un simbol (! @@ # $ % &amp; * ...)</span>
</div>
