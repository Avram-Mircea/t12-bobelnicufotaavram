<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClinicaMedicala</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicaMedicala.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar app-navbar navbar-expand-lg">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">🏥</span>ClinicaMedicala
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">🏠 Acasă</a>
                        </li>

                        @* ─── PACIENT ─── *@
                        @if (User.IsInRole(ClinicaMedicala.Models.Rol.Pacient.ToString()))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Pacient" asp-action="Index">👤 Pagina mea</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Pacient" asp-action="ProgramarileMele">📅 Programările mele</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Pacient" asp-action="FisaMea">🩺 Fișa mea</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Pacient" asp-action="RatingMedici">⭐ Rating medici</a>
                            </li>
                        }

                        @* ─── MEDIC ─── *@
                        @if (User.IsInRole(ClinicaMedicala.Models.Rol.Medic.ToString()))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Medic" asp-action="Index">🏥 Zona Medic</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Medic" asp-action="Programari">📋 Programările mele</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Medic" asp-action="Pacientii">👥 Pacienții mei</a>
                            </li>
                        }

                        @* ─── STAFF (admin/medic/asistent) ─── *@
                        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole(ClinicaMedicala.Models.Rol.Pacient.ToString()))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Programare" asp-action="Index">📋 Programări (staff)</a>
                            </li>
                        }

                        @* ─── ADMIN ─── *@
                        @if (User.IsInRole(ClinicaMedicala.Models.Rol.Admin.ToString()))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown"
                                   role="button" data-bs-toggle="dropdown">⚙️ Administrare</a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-controller="Utilizatori" asp-action="Index">👥 Utilizatori</a></li>
                                    <li><a class="dropdown-item" asp-controller="Resurse" asp-action="Index">🏥 Resurse</a></li>
                                    <li><a class="dropdown-item" asp-controller="Specializari" asp-action="Index">🩺 Specializări</a></li>
                                    <li><a class="dropdown-item" asp-controller="ReguliConsultatii" asp-action="Index">📋 Reguli consultații</a></li>
                                    <li><a class="dropdown-item" asp-controller="ModerareRating" asp-action="Index">⭐ Moderare ratinguri</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Constrangeri" asp-action="TestValidator">🧪 Test validator constrângeri</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    @if (ViewData["FullWidth"] != null)
    {
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="container mt-3">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ClinicaMedicala - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Auto-init Tom Select pe orice <select class="searchable-select">
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('select.searchable-select').forEach(function (el) {
                if (el.tomselect) return; // deja inițializat
                new TomSelect(el, {
                    create: false,
                    allowEmptyOption: true,
                    sortField: { field: 'text', direction: 'asc' },
                    placeholder: el.getAttribute('data-placeholder') || 'Caută sau alege...'
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
