@model ClinicaMedicala.Models.ViewModels.CreareResursaViewModel
@{
    ViewData["Title"] = "Adaugă resursă";
}

<h2>Adaugă resursă nouă</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" autocomplete="off">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"
                 style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

            <div class="row">
                <div class="col-md-7 mb-3">
                    <label asp-for="Denumire" class="form-label"></label>
                    <input asp-for="Denumire" class="form-control" placeholder='ex: „Cabinet Cardiologie 1”' />
                    <span asp-validation-for="Denumire" class="text-danger"></span>
                </div>
                <div class="col-md-5 mb-3">
                    <label asp-for="Tip" class="form-label"></label>
                    <select asp-for="Tip" class="form-select"
                            asp-items="@Html.GetEnumSelectList<ClinicaMedicala.Models.TipResursa>()"></select>
                    <span asp-validation-for="Tip" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-5 mb-3">
                    <label asp-for="NumarInventar" class="form-label"></label>
                    <input asp-for="NumarInventar" class="form-control" placeholder="ex: INV-2026-001" />
                    <span asp-validation-for="NumarInventar" class="text-danger"></span>
                </div>
                <div class="col-md-7 mb-3">
                    <label asp-for="Locatie" class="form-label"></label>
                    <input asp-for="Locatie" class="form-control" placeholder='ex: „Etaj 2, Camera 204”' />
                    <span asp-validation-for="Locatie" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="SpecializarePermisa" class="form-label"></label>
                <input asp-for="SpecializarePermisa" class="form-control" placeholder="ex: Cardiologie" />
                <small class="text-muted">Lasă gol dacă resursa poate fi folosită pentru orice specializare.</small>
            </div>

            <hr />
            <h6 class="text-muted">Mentenanță</h6>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DataUltimaRevizie" class="form-label"></label>
                    <input asp-for="DataUltimaRevizie" class="form-control" type="date" />
                    <span asp-validation-for="DataUltimaRevizie" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DataScadentaRevizie" class="form-label"></label>
                    <input asp-for="DataScadentaRevizie" class="form-control" type="date" />
                    <span asp-validation-for="DataScadentaRevizie" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Salvează resursa</button>
            <a asp-action="Index" class="btn btn-secondary">Anulează</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
