@model IEnumerable<ClinicaMedicala.Models.Utilizator>
@{
    ViewData["Title"] = "Management utilizatori";
    var filtruCurent = ViewBag.FiltruRol as ClinicaMedicala.Models.Rol?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Management utilizatori</h2>
    <a asp-action="Create" class="btn btn-primary">+ Creează cont staff</a>
</div>

@if (TempData["Succes"] != null)
{
    <div class="alert alert-success">@TempData["Succes"]</div>
}
@if (TempData["Eroare"] != null)
{
    <div class="alert alert-danger">@TempData["Eroare"]</div>
}

<form method="get" class="mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-auto"><label class="form-label mb-0">Filtru rol:</label></div>
        <div class="col-auto">
            <select name="filtruRol" class="form-select" onchange="this.form.submit()">
                <option value="">— toate —</option>
                @foreach (var r in Enum.GetValues<ClinicaMedicala.Models.Rol>())
                {
                    <option value="@r" selected="@(filtruCurent == r)">@r</option>
                }
            </select>
        </div>
    </div>
</form>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>Nume</th>
            <th>Prenume</th>
            <th>Email</th>
            <th>Rol</th>
            <th>Status</th>
            <th>Creat la</th>
            <th class="text-end">Acțiuni</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.Nume</td>
            <td>@u.Prenume</td>
            <td>@u.Email</td>
            <td><span class="badge bg-secondary">@u.Rol</span></td>
            <td>
                @if (u.StatusCont)
                {
                    <span class="badge bg-success">Activ</span>
                }
                else
                {
                    <span class="badge bg-danger">Dezactivat</span>
                }
            </td>
            <td>@u.DataCreareCont.ToLocalTime().ToString("dd.MM.yyyy")</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Detalii</a>
                @if (u.StatusCont)
                {
                    <form asp-action="Dezactiveaza" asp-route-id="@u.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Sigur dezactivezi contul @u.Email?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Dezactivează</button>
                    </form>
                }
                else
                {
                    <form asp-action="Reactiveaza" asp-route-id="@u.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-success">Reactivează</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">Niciun utilizator găsit.</div>
}
