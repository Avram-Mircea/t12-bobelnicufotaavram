@model ClinicaMedicala.Models.ViewModels.EditeazaUtilizatorViewModel
@{
    ViewData["Title"] = "Editare cont";
    var rol = Model.Rol;
}

<h2>Editare cont</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

            <h6 class="text-muted">Date cont (necesită admin pentru schimbare)</h6>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" readonly />
                    <small class="text-muted">Email-ul nu poate fi schimbat (identifică contul pentru autentificare)</small>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Rol" class="form-label"></label>
                    <input asp-for="Rol" class="form-control" readonly />
                </div>
            </div>

            <h6 class="text-muted mt-3">Date personale</h6>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Nume" class="form-label"></label>
                    <input asp-for="Nume" class="form-control" />
                    <span asp-validation-for="Nume" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Prenume" class="form-label"></label>
                    <input asp-for="Prenume" class="form-control" />
                    <span asp-validation-for="Prenume" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Telefon" class="form-label"></label>
                    <input asp-for="Telefon" class="form-control" />
                    <span asp-validation-for="Telefon" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Adresa" class="form-label"></label>
                    <input asp-for="Adresa" class="form-control" />
                    <span asp-validation-for="Adresa" class="text-danger"></span>
                </div>
            </div>

            @if (rol == "Medic")
            {
                <h6 class="text-muted mt-3">Date profesionale (medic)</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Specializare" class="form-label"></label>
                        <input asp-for="Specializare" class="form-control" />
                        <span asp-validation-for="Specializare" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CodParafa" class="form-label"></label>
                        <input asp-for="CodParafa" class="form-control" maxlength="6" />
                        <span asp-validation-for="CodParafa" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="GradProfesional" class="form-label"></label>
                        <select asp-for="GradProfesional" class="form-select"
                                asp-items="@Html.GetEnumSelectList<ClinicaMedicala.Models.GradProfesional>()"></select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="CostConsultatie" class="form-label"></label>
                        <input asp-for="CostConsultatie" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="NumarContractCAS" class="form-label"></label>
                        <input asp-for="NumarContractCAS" class="form-control" />
                    </div>
                </div>
            }
            else if (rol == "Asistent")
            {
                <h6 class="text-muted mt-3">Date asistent</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Departament" class="form-label"></label>
                        <input asp-for="Departament" class="form-control" />
                        <span asp-validation-for="Departament" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Tura" class="form-label"></label>
                        <select asp-for="Tura" class="form-select"
                                asp-items="@Html.GetEnumSelectList<ClinicaMedicala.Models.Tura>()"></select>
                    </div>
                </div>
            }
            else if (rol == "Pacient")
            {
                <h6 class="text-muted mt-3">Date pacient (identitate — readonly)</h6>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="CNP" class="form-label"></label>
                        <input asp-for="CNP" class="form-control" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="DataNastere" class="form-label"></label>
                        <input asp-for="DataNastere" class="form-control" type="date" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="GrupaSanguina" class="form-label"></label>
                        <input value="@Model.GrupaSanguina" class="form-control" readonly />
                    </div>
                </div>

                <h6 class="text-muted mt-3">Date medicale și contact urgență</h6>
                <div class="form-check mb-3">
                    <input asp-for="AsiguratCNAS" class="form-check-input" />
                    <label asp-for="AsiguratCNAS" class="form-check-label"></label>
                </div>
                <div class="mb-3">
                    <label asp-for="AlergiiCunoscute" class="form-label"></label>
                    <textarea asp-for="AlergiiCunoscute" class="form-control" rows="2"></textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContactUrgentaNume" class="form-label"></label>
                        <input asp-for="ContactUrgentaNume" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContactUrgentaTelefon" class="form-label"></label>
                        <input asp-for="ContactUrgentaTelefon" class="form-control" />
                    </div>
                </div>
            }

            <hr />
            <button type="submit" class="btn btn-primary">Salvează modificările</button>
            <a asp-action="Index" class="btn btn-secondary">Anulează</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
