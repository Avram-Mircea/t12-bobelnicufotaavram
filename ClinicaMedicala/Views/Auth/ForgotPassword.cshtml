@model ClinicaMedicala.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperare parolă";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="card-title text-center mb-3">Recuperare parolă</h3>
                <p class="text-muted text-center">Introduceți email-ul pentru a primi un link de resetare.</p>

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Trimite link de resetare</button>
                </form>

                <div class="mt-3 text-center">
                    <a asp-action="Login">Înapoi la autentificare</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
